# Traefik basicauth for the OTLP collector endpoint (otel.tools.juliendelrio.fr).
# Format: user:hashed_password (generate with `htpasswd -nb user password`).
# Multiple users are comma-separated. Escape every '$' as '$$' for docker compose.
OTEL_AUTH_USERS=

# Grafana admin password (user: admin) for tokens.tools.juliendelrio.fr.
GRAFANA_ADMIN_PASSWORD=
