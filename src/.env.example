# --- Public hostnames (Traefik routing) ---
# Hostname for the OTLP collector endpoint Claude Code sends metrics to.
OTEL_HOST=otel.example.com
# Hostname for the Grafana UI.
GRAFANA_HOST=grafana.example.com

# --- Traefik integration ---
# External Docker network your Traefik instance is attached to.
TRAEFIK_NETWORK=web
# Traefik certificate resolver name (as defined in your Traefik config).
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Secrets ---
# Traefik basicauth protecting the OTLP collector endpoint (OTEL_HOST).
# Format: user:hashed_password (generate with `htpasswd -nb user password`).
# Multiple users are comma-separated. Escape every '$' as '$$' for docker compose.
OTEL_AUTH_USERS=

# Grafana admin password (login user: admin).
GRAFANA_ADMIN_PASSWORD=
